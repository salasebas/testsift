# Rails fixture — only the app source is committed.
# Runtime artefacts are regenerated on each `bundle install` + `rspec` run.

/.bundle/
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
/vendor/bundle

/db/*.sqlite3
/db/*.sqlite3-*

# SimpleCov + testsift artefacts. Populated by the
# integration matrix (TESTSIFT=1 runs) + the cold_rails_v2
# benchmark scenario; never hand-committed.
/coverage/
/testsift_cache/
/testsift_coverage/
/testsift_report/

Gemfile.lock
.byebug_history
