## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# testsift is a library: Gemfile.lock is not committed so each
# consumer / CI cell / supported Ruby version resolves its own
# compatible dep set (cf. Bundler's own `bundle gem` scaffold).
# Frees us to pin Ruby-version-conditional gems like sqlite3 without
# the committed lock forcing a single resolution across the matrix.
Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*

.DS_Store

# Internal 2.0 revamp planning — kept locally per-maintainer, NOT committed.
# See CLAUDE.md / AGENTS.md for why.
/docs/revamp/

# mutant session history — per-run artifact, not source.
/.mutant/

# HTML reporter frontend toolchain - dist/ IS committed (users run
# nothing), but node_modules + Vite's local caches must never be.
/lib/testsift/reporters/html/node_modules/
/lib/testsift/reporters/html/.vite/
/lib/testsift/reporters/html/.vite-cache/
/lib/testsift/reporters/html/.eslintcache
